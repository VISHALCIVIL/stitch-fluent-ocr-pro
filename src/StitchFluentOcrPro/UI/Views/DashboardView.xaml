<UserControl x:Class="StitchFluentOcrPro.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <TextBlock Text="System Dashboard" Style="{StaticResource DisplayLargeStyle}" Margin="0,0,0,8"/>
            <TextBlock Text="Real-time OCR throughput, system resource telemetry, and worker status." Style="{StaticResource BodyMediumStyle}" Margin="0,0,0,24"/>

            <!-- Metric Cards Row 1 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Throughput PPM -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="THROUGHPUT" Style="{StaticResource BodySmallStyle}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Stats.PagesPerMinute, StringFormat='{}{0:F1} PPM'}" 
                                   Style="{StaticResource TitleMediumStyle}" FontSize="24" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Pages per minute" Style="{StaticResource BodySmallStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: CPU Utilization -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="CPU USAGE" Style="{StaticResource BodySmallStyle}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Stats.CpuUsagePercent, StringFormat='{}{0:F1} %'}" 
                                   Style="{StaticResource TitleMediumStyle}" FontSize="24" Foreground="{StaticResource OnSurfaceBrush}" Margin="0,8,0,0"/>
                        <ProgressBar Value="{Binding Stats.CpuUsagePercent}" Maximum="100" Height="6" Margin="0,8,0,0" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: RAM Memory -->
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="MEMORY USAGE" Style="{StaticResource BodySmallStyle}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Stats.RamUsageBytes, Converter={StaticResource BytesConverter}}" 
                                   Style="{StaticResource TitleMediumStyle}" FontSize="24" Foreground="{StaticResource OnSurfaceBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Working set memory" Style="{StaticResource BodySmallStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Active Workers -->
                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE WORKERS" Style="{StaticResource BodySmallStyle}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Stats.ActiveWorkers}" 
                                   Style="{StaticResource TitleMediumStyle}" FontSize="24" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Parallel threads" Style="{StaticResource BodySmallStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Operational Counters Row 2 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Batch Execution Overview" Style="{StaticResource TitleMediumStyle}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Files Discovered" Style="{StaticResource BodySmallStyle}"/>
                            <TextBlock Text="{Binding Stats.TotalFiles}" Style="{StaticResource TitleMediumStyle}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Completed Files" Style="{StaticResource BodySmallStyle}"/>
                            <TextBlock Text="{Binding Stats.CompletedFiles}" Style="{StaticResource TitleMediumStyle}" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Skipped Existing" Style="{StaticResource BodySmallStyle}"/>
                            <TextBlock Text="{Binding Stats.SkippedFiles}" Style="{StaticResource TitleMediumStyle}" Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Failed Files" Style="{StaticResource BodySmallStyle}"/>
                            <TextBlock Text="{Binding Stats.FailedFiles}" Style="{StaticResource TitleMediumStyle}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Live Active File Telemetry -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Current File Execution" Style="{StaticResource TitleMediumStyle}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Stats.CurrentFileName, TargetNullValue='No active file'}" Style="{StaticResource MonoDataStyle}" FontSize="14" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total Pages Processed: " Style="{StaticResource BodyMediumStyle}" Grid.Column="0"/>
                        <TextBlock Text="{Binding Stats.ProcessedPages}" Style="{StaticResource BodyMediumStyle}" FontWeight="Bold" Grid.Column="1" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
